# ── NovTurnIA — variables del harness E2E (QA fase A) ─────────────────────
# Copiá este archivo a `.env.test` (gitignored) y completá los valores.
# NUNCA la service_role acá — solo la anon/publishable key, la misma que usa
# el frontend en producción. `.env.test` es consumido por:
#   - playwright.config.js (arranca `vite --mode test`, que carga ESTE archivo)
#   - tests/setup/global-setup.js (login real de owner/secretary)
#   - scripts/seed-test-tenant.mjs

# ── Supabase — mismo proyecto que producción (free tier, sin branching) ────
# El aislamiento es por business_id, NO por proyecto. Ver docs/Contrato de
# Agentes.md §4. Obtenidas vía MCP de Supabase (get_project_url / get_publishable_keys).
VITE_SUPABASE_URL=https://kwpaaqdkklwwfslhkqpb.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Negocio semilla ──────────────────────────────────────────────────────
# Se completa DESPUÉS de correr /admin/new-tenant (super-admin) para crear el
# tenant de QA. Guarda de seguridad en scripts/seed-test-tenant.mjs: si no
# coincide con el business_id real del owner logueado, el seed aborta.
SEED_BUSINESS_ID=

# Owner del negocio semilla — todos los permisos (ver OWNER_PERMISSIONS en
# supabase/functions/onboard-tenant/index.ts).
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Secretary del negocio semilla — permisos operativos, sin borrar/ver stats/
# gestionar roles (ver SECRETARY_PERMISSIONS en el mismo archivo). Usado para
# probar permisos (owner ve X, secretary no).
SEED_SECRETARY_EMAIL=
SEED_SECRETARY_PASSWORD=

# ── Playwright (opcional — defaults razonables si se omiten) ───────────────
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
# PLAYWRIGHT_PORT=5173
